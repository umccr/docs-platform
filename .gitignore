# Build output: never commit a generated site (see docs/site/publishing.md). docs/site/ itself is the platform
# site's source; the site/ it builds into is still ignored. `make sites` builds into build/.
site/
!/docs/site/
.umccr-docs/
build/

# The virtualenv with the repository's tools and the toolkit
.venv/

# Local state and credentials
.env
*.tfstate
*.tfstate.*
.DS_Store

# CDK app (TypeScript)
node_modules/
.pnpm-store/
.pnpm-debug.log
cdk.out/
.cdk.staging
*.d.ts
# Compiled JS is never committed. Exceptions: config files and the hand-written edge function.
*.js
!jest.config.js
!app/**/*.js
