# Build output: never commit a generated site (see app/site/docs/publishing.md). app/site/ itself is the platform
# site's source; the site/ it builds into is still ignored.
site/
!/app/site/
.umccr-docs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/

# Local state and credentials
.env
*.tfstate
*.tfstate.*
.DS_Store

# CDK app (TypeScript)
node_modules/
.pnpm-store/
.pnpm-debug.log
cdk.out/
.cdk.staging
*.d.ts
# Compiled JS is never committed. Exceptions: config files, the hand-written edge function, and the theme's script.
*.js
!jest.config.js
!app/**/*.js
!toolkit/src/umccr_docs/theme/**/*.js
